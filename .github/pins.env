# What RDLKit builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux  the GNUstep stack's archive, unpacked into /opt/gnustep
#   Apple  Sparkle's XCFramework, unpacked into .deps/

# The patched GNUstep stack (ashalkhakov/gnustep-patches): libobjc2,
# libdispatch, tools-make, libs-base and libs-gui with the patches RDLKit
# needs (Patches/README.md), libs-back, tools-xctest.
GNUSTEP_PATCHES_VERSION=2026.10.20.38
# RDLDesigner's updates on macOS.
SPARKLE_VERSION=2.10.0
# UDCode's SDK (ashalkhakov/UDCodeKit's udcodekit archives): what the RDL
# extension builds on. The stack above is that UDCode release's: the
# extension uses UDCode's.
UDCODEKIT_VERSION=0.22.2
# What UDCode's SDK links on Windows, and so the installer's closure needs: the
# DiagramKit that UDCode release carries (ashalkhakov/DiagramKit).
DIAGRAMKIT_VERSION=0.2.1
