#!/bin/sh
# Launcher for the RDLKit AppImage.
#
# GNUstep finds everything through a config file and a set of root variables,
# and inside an AppImage those roots are wherever the image happens to be
# mounted. prepare-appdir.sh recorded them at build time, as they came out of
# gnustep-config, with @HERE@ where the mount point goes; all that is left to
# do here is substitute it. Nothing about the layout is assumed on this side,
# which is the point -- the two previous versions of this file each hard-coded
# a different one, and each was wrong for the other prefix.
set -eu

HERE="$(dirname "$(readlink -f "$0")")"

expand() { sed "s|@HERE@|$HERE|g" "$1"; }

export GNUSTEP_CONFIG_FILE="/tmp/GNUstep-Pica-$$.conf"
expand "$HERE/usr/GNUstep.conf.in" > "$GNUSTEP_CONFIG_FILE"
chmod 600 "$GNUSTEP_CONFIG_FILE"

paths="/tmp/pica-paths-$$.sh"
expand "$HERE/usr/pica-paths.in" > "$paths"
. "$paths"

export LD_LIBRARY_PATH="$PICA_LIBS:$HERE/usr/lib:${LD_LIBRARY_PATH:-}"
export PATH="$HERE/usr/local/bin:$(dirname "$PICA_TOOL"):$PATH"

# The bundled fonts are the point of shipping any: a report names Arial or
# Times New Roman, and what the host has installed decides how it paginates.
# See "Fonts and layout across platforms" in the README.
export FONTCONFIG_FILE="$HERE/usr/etc/fonts/fonts.conf"
export XDG_CACHE_HOME="/tmp/pica-fc-cache-$$"
mkdir -p "$XDG_CACHE_HOME"
trap 'rm -rf "$XDG_CACHE_HOME" "$GNUSTEP_CONFIG_FILE" "$paths"' EXIT

# The image carries two programs. Invoked as picagen, or with picagen as the
# first argument, it is the command line tool; otherwise it is the designer.
case "${1:-}" in
  picagen)
    shift
    exec "$PICA_TOOL" "$@"
    ;;
esac
case "$(basename "${ARGV0:-$0}")" in
  picagen)
    exec "$PICA_TOOL" "$@"
    ;;
esac

# Eau is shipped in the image and asked for by default: it is the look users
# expect from a GNUstep desktop, and stock GNUstep is not it. Set PICA_THEME to
# the name of another installed theme to change it, or to the empty string to
# get GNUstep's own. A -GSTheme passed by the caller wins over this one, since
# the argument domain takes the last occurrence.
theme="${PICA_THEME-${PICA_DEFAULT_THEME:-}}"
if [ -n "$theme" ]; then
  exec "$PICA_APP" -GSTheme "$theme" "$@"
fi
exec "$PICA_APP" "$@"
