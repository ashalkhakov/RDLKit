<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <!-- The report viewer: the bar of buttons, the parameters under it
             (filled in code, as tall as the report needs), the pages, and a
             line of notes. Where the bars go is worked out in
             -[RDLReportViewController layOutBars]. -->
        <customObject id="-2" userLabel="File's Owner" customClass="RDLReportViewController">
            <connections>
                <outlet property="view" destination="viewerContent" id="viewerContentOutlet"/>
                <outlet property="toolbar" destination="toolbar" id="toolbarOutlet"/>
                <outlet property="parameterBar" destination="parameterBar" id="parameterBarOutlet"/>
                <outlet property="scroll" destination="scroll" id="scrollOutlet"/>
                <outlet property="reportView" destination="reportView" id="reportViewOutlet"/>
                <outlet property="pageLabel" destination="pageLabel" id="pageLabelOutlet"/>
                <outlet property="notesLabel" destination="notesLabel" id="notesLabelOutlet"/>
                <outlet property="zoomPop" destination="zoomPop" id="zoomPopOutlet"/>
                <outlet property="parametersButton" destination="parametersButton" id="parametersButtonOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="viewerContent" customClass="RDLViewerRootView">
            <rect key="frame" x="0.0" y="0.0" width="800" height="600"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <customView id="toolbar">
                    <rect key="frame" x="0.0" y="568" width="800" height="32"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <subviews>
                            <button toolTip="First page" id="firstButton">
                                <rect key="frame" x="8" y="4" width="34" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="|◀" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="firstButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="goToFirstPage:" target="-2" id="firstButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Previous page" id="previousButton">
                                <rect key="frame" x="44" y="4" width="30" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="◀" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="previousButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="goToPreviousPage:" target="-2" id="previousButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Next page" id="nextButton">
                                <rect key="frame" x="76" y="4" width="30" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="▶" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="nextButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="goToNextPage:" target="-2" id="nextButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Last page" id="lastButton">
                                <rect key="frame" x="108" y="4" width="34" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="▶|" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="lastButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="goToLastPage:" target="-2" id="lastButtonAction"/>
                                </connections>
                            </button>
                            <textField verticalHuggingPriority="750" id="pageLabel">
                                <rect key="frame" x="148" y="8" width="104" height="16"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" sendsActionOnEndEditing="YES" title="No pages" id="pageLabelCell">
                                    <font key="font" metaFont="smallSystem"/>
                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                </textFieldCell>
                            </textField>
                            <popUpButton toolTip="Zoom" id="zoomPop">
                                <rect key="frame" x="256" y="4" width="78" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <popUpButtonCell key="cell" type="push" title="100%" bezelStyle="rounded" alignment="left" controlSize="small" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="viewerZoom100" id="zoomPopCell">
                                    <behavior key="behavior" lightByContents="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                    <menu key="menu" title="OtherViews" id="viewerZoomMenu">
                                        <items>
                                            <menuItem title="100%" state="on" id="viewerZoom100"/>
                                        </items>
                                    </menu>
                                </popUpButtonCell>
                            </popUpButton>
                            <button toolTip="Show or hide the report's parameters" id="parametersButton">
                                <rect key="frame" x="340" y="4" width="92" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Parameters" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="parametersButtonCell">
                                    <behavior key="behavior" pushIn="YES" changeContents="YES" lightByContents="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="toggleParameters:" target="-2" id="parametersButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Read the data again and render" id="refreshButton">
                                <rect key="frame" x="436" y="4" width="74" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Refresh" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="refreshButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="refresh:" target="-2" id="refreshButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Export as PDF" id="pdfButton">
                                <rect key="frame" x="514" y="4" width="60" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="PDF…" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="pdfButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="exportPDF:" target="-2" id="pdfButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Export as HTML" id="htmlButton">
                                <rect key="frame" x="578" y="4" width="64" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="HTML…" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="htmlButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="exportHTML:" target="-2" id="htmlButtonAction"/>
                                </connections>
                            </button>
                            <button toolTip="Print the report" id="printButton">
                                <rect key="frame" x="646" y="4" width="64" height="24"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Print…" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="printButtonCell">
                                    <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                    <font key="font" metaFont="smallSystem"/>
                                </buttonCell>
                                <connections>
                                    <action selector="printReport:" target="-2" id="printButtonAction"/>
                                </connections>
                            </button>
                    </subviews>
                </customView>
                <customView id="parameterBar">
                    <rect key="frame" x="0.0" y="568" width="800" height="0.0"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </customView>
                <scrollView horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="scroll">
                    <rect key="frame" x="0.0" y="20" width="800" height="548"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" copiesOnScroll="NO" id="scrollClip">
                        <rect key="frame" x="1" y="1" width="783" height="531"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <customView id="reportView" customClass="RDLView">
                                <rect key="frame" x="0.0" y="0.0" width="612" height="792"/>
                                <autoresizingMask key="autoresizingMask"/>
                            </customView>
                        </subviews>
                        <color key="backgroundColor" white="0.82" alpha="1" colorSpace="calibratedWhite"/>
                    </clipView>
                    <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="scrollHorizontal">
                        <rect key="frame" x="1" y="532" width="783" height="15"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                    <scroller key="verticalScroller" verticalHuggingPriority="750" doubleValue="1" horizontal="NO" id="scrollVertical">
                        <rect key="frame" x="784" y="1" width="15" height="531"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </scroller>
                </scrollView>
                <textField verticalHuggingPriority="750" id="notesLabel">
                    <rect key="frame" x="8" y="2" width="784" height="16"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" sendsActionOnEndEditing="YES" id="notesLabelCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <point key="canvasLocation" x="140" y="144"/>
        </customView>
    </objects>
</document>
