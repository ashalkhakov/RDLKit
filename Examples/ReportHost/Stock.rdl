<?xml version="1.0" encoding="utf-8"?>
<!-- The report ReportHost shows: its rows are the host's, asked for by
     dataset and region (ReportHost.m), so the report names no data source. -->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <Width>6in</Width>
  <ReportParameters>
    <ReportParameter Name="Region">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>North</Value></Values></DefaultValue>
      <Prompt>Region</Prompt>
      <ValidValues><ParameterValues>
        <ParameterValue><Value>North</Value></ParameterValue>
        <ParameterValue><Value>South</Value></ParameterValue>
      </ParameterValues></ValidValues>
    </ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="Items">
      <Fields>
        <Field Name="Name"><DataField>Name</DataField></Field>
        <Field Name="Qty"><DataField>Qty</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <Height>2in</Height>
    <ReportItems>
      <Textbox Name="Title">
        <Top>0in</Top><Left>0in</Left><Width>4in</Width><Height>0.35in</Height>
        <Paragraphs><Paragraph><TextRuns><TextRun>
          <Value>="Stock in the " &amp; Parameters!Region.Value</Value>
          <Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style>
        </TextRun></TextRuns></Paragraph></Paragraphs>
      </Textbox>
      <Textbox Name="Total">
        <Top>0.4in</Top><Left>0in</Left><Width>4in</Width><Height>0.25in</Height>
        <Paragraphs><Paragraph><TextRuns><TextRun>
          <Value>="Total: " &amp; Sum(Fields!Qty.Value, "Items")</Value>
        </TextRun></TextRuns></Paragraph></Paragraphs>
      </Textbox>
      <List Name="Lines">
        <Top>0.8in</Top><Left>0in</Left><Width>4in</Width><Height>0.3in</Height>
        <DataSetName>Items</DataSetName>
        <ReportItems>
          <Textbox Name="Line">
            <Top>0in</Top><Left>0in</Left><Width>4in</Width><Height>0.25in</Height>
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>=Fields!Name.Value &amp; ": " &amp; Fields!Qty.Value</Value>
            </TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </List>
    </ReportItems>
  </Body>
  <Page><PageHeight>11in</PageHeight><PageWidth>8.5in</PageWidth></Page>
</Report>
