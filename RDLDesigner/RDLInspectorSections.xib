        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <!-- These are the inspector's sections, and RDLInspectorView, which
             they are added to, is a flipped view. So min-Y is the TOP edge
             here, and a section pinned with flexibleMinY sank down the pane
             every time the window grew, which read as the inspector centring
             itself. flexibleMaxY is what keeps a section at the top of a
             flipped parent. -->
        <textField focusRingType="none" verticalHuggingPriority="750" id="kindLabel">
            <rect key="frame" x="0.0" y="0.0" width="240" height="16"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <textFieldCell key="cell" title="Report" id="kindLabelCell">
                <font key="font" metaFont="smallSystemBold"/>
                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
            </textFieldCell>
            <point key="canvasLocation" x="140" y="154"/>
        </textField>
        <customView id="docBox">
            <rect key="frame" x="0.0" y="0.0" width="260" height="334"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lbl1">
                    <rect key="frame" x="10" y="4" width="240" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" title="Name" id="lbl1Cell">
                        <font key="font" metaFont="user" size="10"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" id="docNameField">
                    <rect key="frame" x="10" y="20" width="240" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="docNameFieldCell">
                        <font key="font" metaFont="user" size="11"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="changed:" target="-2" id="docNameFieldAction"/>
                        <outlet property="delegate" destination="-2" id="docNameFieldDelegate"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lbl2">
                    <rect key="frame" x="10" y="48" width="240" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" title="Author" id="lbl2Cell">
                        <font key="font" metaFont="user" size="10"/>
