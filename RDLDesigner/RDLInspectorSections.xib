            <point key="canvasLocation" x="140" y="-86"/>
        </customView>
        <customView id="paperBox">
            <rect key="frame" x="0.0" y="28" width="260" height="340"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblPaper">
                    <rect key="frame" x="10" y="4" width="240" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
