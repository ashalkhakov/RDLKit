                    </textFieldCell>
                </textField>
                <textField focusRingType="none" id="descField">
                    <rect key="frame" x="10" y="108" width="240" height="44"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="descFieldCell">
