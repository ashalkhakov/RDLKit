<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="RDLParameterInspectorView">
            <connections>
                <outlet property="content" destination="content" id="contentOutlet"/>
                <outlet property="nameField" destination="nameField" id="nameFieldOutlet"/>
                <outlet property="promptCheck" destination="promptCheck" id="promptCheckOutlet"/>
                <outlet property="promptField" destination="promptField" id="promptFieldOutlet"/>
                <outlet property="referenceLabel" destination="referenceLabel" id="referenceLabelOutlet"/>
                <outlet property="typePop" destination="typePop" id="typePopOutlet"/>
                <outlet property="nullableCheck" destination="nullableCheck" id="nullableCheckOutlet"/>
                <outlet property="allowBlankCheck" destination="allowBlankCheck" id="allowBlankCheckOutlet"/>
                <outlet property="hiddenCheck" destination="hiddenCheck" id="hiddenCheckOutlet"/>
                <outlet property="defaultsButton" destination="defaultsButton" id="defaultsButtonOutlet"/>
                <outlet property="validValuesButton" destination="validValuesButton" id="validValuesButtonOutlet"/>
                <outlet property="multiCheck" destination="multiCheck" id="multiCheckOutlet"/>
                <outlet property="defaultField" destination="defaultField" id="defaultFieldOutlet"/>
                <outlet property="validScroll" destination="validScroll" id="validScrollOutlet"/>
                <outlet property="validText" destination="validText" id="validTextOutlet"/>
                <outlet property="empty" destination="emptyLabel" id="emptyLabelOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="content">
            <rect key="frame" x="0.0" y="0.0" width="280" height="400"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblPName">
                    <rect key="frame" x="8" y="370" width="264" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Name" id="lblPNameCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField toolTip="What expressions call it: Parameters!Name.Value" focusRingType="none" id="nameField">
                    <rect key="frame" x="8" y="346" width="264" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="nameFieldCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="rename:" target="-2" id="nameFieldAction"/>
                        <outlet property="delegate" destination="-2" id="nameFieldDelegate"/>
                    </connections>
                </textField>
                <button toolTip="Unasked, the parameter always takes its default, and the report cannot be run with another value" id="promptCheck">
                    <rect key="frame" x="150" y="316" width="122" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Asked for" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="promptCheckCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="promptCheckAction"/>
                    </connections>
                </button>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblPPrompt">
                    <rect key="frame" x="8" y="318" width="136" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Prompt" id="lblPPromptCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField toolTip="What the person running the report is asked" focusRingType="none" id="promptField">
                    <rect key="frame" x="8" y="294" width="264" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="promptFieldCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="changed:" target="-2" id="promptFieldAction"/>
                        <outlet property="delegate" destination="-2" id="promptFieldDelegate"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblPType">
                    <rect key="frame" x="8" y="266" width="264" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Type" id="lblPTypeCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton toolTip="How the value is read before the report sees it" id="typePop">
                    <rect key="frame" x="8" y="242" width="264" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="typePopCell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="typePopMenu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="typePopAction"/>
                    </connections>
                </popUpButton>
                <button toolTip="The report can run with no value at all — Nothing" id="nullableCheck">
                    <rect key="frame" x="8" y="214" width="126" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Allows null" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="nullableCheckCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="nullableCheckAction"/>
                    </connections>
                </button>
                <button toolTip="An empty text is a value of a String parameter" id="allowBlankCheck">
                    <rect key="frame" x="8" y="192" width="126" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Allows blank" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="allowBlankCheckCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="allowBlankCheckAction"/>
                    </connections>
                </button>
                <button toolTip="Asked for nowhere, though a host may still give it a value" id="hiddenCheck">
                    <rect key="frame" x="140" y="192" width="126" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Hidden" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="hiddenCheckCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="hiddenCheckAction"/>
                    </connections>
                </button>
                <button toolTip="The values a parameter of several values starts with" id="defaultsButton">
                    <rect key="frame" x="208" y="141" width="64" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="push" title="List…" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="defaultsButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <action selector="editDefaultValues:" target="-2" id="defaultsButtonAction"/>
                    </connections>
                </button>
                <button toolTip="The values the parameter accepts, and the label each is shown under" id="validValuesButton">
                    <rect key="frame" x="180" y="110" width="92" height="24"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="push" title="Edit…" bezelStyle="rounded" alignment="center" controlSize="small" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="validValuesButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <action selector="editValidValues:" target="-2" id="validValuesButtonAction"/>
                    </connections>
                </button>
                <button toolTip="The value is a list — Parameters!P.Value is an array" id="multiCheck">
                    <rect key="frame" x="140" y="214" width="126" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Several values" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="multiCheckCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="multiCheckAction"/>
                    </connections>
                </button>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblPDefault">
                    <rect key="frame" x="8" y="166" width="264" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Default" id="lblPDefaultCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField toolTip="The value it starts with — a constant, or an = expression" focusRingType="none" id="defaultField" customClass="RDLExpressionField">
                    <rect key="frame" x="8" y="142" width="196" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="defaultFieldCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="changed:" target="-2" id="defaultFieldAction"/>
                        <outlet property="delegate" destination="-2" id="defaultFieldDelegate"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblPValid">
                    <rect key="frame" x="8" y="114" width="170" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Accepts (none listed: anything)" id="lblPValidCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <scrollView horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="validScroll">
                    <rect key="frame" x="8" y="34" width="264" height="76"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" copiesOnScroll="NO" id="validClip">
                        <rect key="frame" x="1" y="1" width="247" height="74"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textView editable="YES" selectable="YES" richText="NO" importsGraphics="NO" verticallyResizable="YES" spellCheckingEnabled="NO" id="validText">
                                <rect key="frame" x="0.0" y="0.0" width="247" height="74"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <color key="insertionPointColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                <connections>
                                    <outlet property="delegate" destination="-2" id="validTextDelegate"/>
                                </connections>
                            </textView>
                        </subviews>
                    </clipView>
                    <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="validScroller">
                        <rect key="frame" x="248" y="1" width="15" height="74"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
                    </scroller>
                </scrollView>
                <textField focusRingType="none" verticalHuggingPriority="750" id="referenceLabel">
                    <rect key="frame" x="8" y="4" width="264" height="28"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="wordWrap" selectable="YES" title="" id="referenceLabelCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="emptyLabel">
                    <rect key="frame" x="8" y="200" width="264" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="No parameter selected" id="emptyLabelCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <point key="canvasLocation" x="140" y="204"/>
        </customView>
    </objects>
</document>
