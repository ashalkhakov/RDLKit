<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="RDLDataSourceView">
            <connections>
                <outlet property="content" destination="content" id="contentOutlet"/>
                <outlet property="nameField" destination="nameField" id="nameFieldOutlet"/>
                <outlet property="typePop" destination="typePop" id="typePopOutlet"/>
                <outlet property="wherePop" destination="wherePop" id="wherePopOutlet"/>
                <outlet property="documentLabel" destination="documentLabel" id="documentLabelOutlet"/>
                <outlet property="documentField" destination="documentField" id="documentFieldOutlet"/>
                <outlet property="contentScroll" destination="contentScroll" id="contentScrollOutlet"/>
                <outlet property="contentView" destination="contentText" id="contentTextOutlet"/>
                <outlet property="headerCheck" destination="headerCheck" id="headerCheckOutlet"/>
                <outlet property="delimiterPop" destination="delimiterPop" id="delimiterPopOutlet"/>
                <outlet property="widthsField" destination="widthsField" id="widthsFieldOutlet"/>
                <outlet property="summaryLabel" destination="summaryLabel" id="summaryLabelOutlet"/>
                <outlet property="empty" destination="empty" id="emptyOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="content">
            <rect key="frame" x="0.0" y="0.0" width="400" height="300"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblName">
                    <rect key="frame" x="8" y="278" width="384" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Name" id="lblNameCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField toolTip="What datasets call this source" focusRingType="none" id="nameField">
                    <rect key="frame" x="8" y="252" width="384" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="nameFieldCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="rename:" target="-2" id="nameFieldAction"/>
                        <outlet property="delegate" destination="-2" id="nameFieldDelegate"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblType">
                    <rect key="frame" x="8" y="226" width="150" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Kind of document" id="lblTypeCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton toolTip="JSON, XML or delimited text" id="typePop">
                    <rect key="frame" x="8" y="200" width="150" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="typePopCell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="typePopMenu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="typePopAction"/>
                    </connections>
                </popUpButton>
                <textField focusRingType="none" verticalHuggingPriority="750" id="lblWhere">
                    <rect key="frame" x="170" y="226" width="222" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="Where it is" id="lblWhereCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton toolTip="A file beside the report, or content carried in it" id="wherePop">
                    <rect key="frame" x="170" y="200" width="222" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="wherePopCell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="wherePopMenu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="wherePopAction"/>
                    </connections>
                </popUpButton>
                <button toolTip="The first line names the columns" id="headerCheck">
                    <rect key="frame" x="8" y="172" width="156" height="20"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="First row is a header" bezelStyle="regularSquare" imagePosition="left" alignment="left" inset="2" id="headerCheckCell">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="headerCheckAction"/>
                    </connections>
                </button>
                <popUpButton toolTip="What separates one column from the next" id="delimiterPop">
                    <rect key="frame" x="170" y="170" width="106" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="delimiterPopCell">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <menu key="menu" id="delimiterPopMenu"/>
                    </popUpButtonCell>
                    <connections>
                        <action selector="changed:" target="-2" id="delimiterPopAction"/>
                    </connections>
                </popUpButton>
                <textField toolTip="Fixed-width columns instead of a delimiter: 10,20,8" focusRingType="none" id="widthsField">
                    <rect key="frame" x="286" y="170" width="106" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" placeholderString="widths" id="widthsFieldCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="changed:" target="-2" id="widthsFieldAction"/>
                        <outlet property="delegate" destination="-2" id="widthsFieldDelegate"/>
                    </connections>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="documentLabel">
                    <rect key="frame" x="8" y="144" width="384" height="14"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" selectable="YES" title="File" id="documentLabelCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField toolTip="A file beside the report — orders.json" focusRingType="none" id="documentField">
                    <rect key="frame" x="8" y="118" width="384" height="22"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="documentFieldCell">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <action selector="changed:" target="-2" id="documentFieldAction"/>
                        <outlet property="delegate" destination="-2" id="documentFieldDelegate"/>
                    </connections>
                </textField>
                <scrollView horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="contentScroll">
                    <rect key="frame" x="8" y="26" width="384" height="114"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <clipView key="contentView" copiesOnScroll="NO" id="contentClip">
                        <rect key="frame" x="1" y="1" width="367" height="112"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textView editable="YES" selectable="YES" richText="NO" importsGraphics="NO" verticallyResizable="YES" spellCheckingEnabled="NO" id="contentText">
                                <rect key="frame" x="0.0" y="0.0" width="367" height="112"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                <color key="insertionPointColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                <connections>
                                    <outlet property="delegate" destination="-2" id="contentTextDelegate"/>
                                </connections>
                            </textView>
                        </subviews>
                    </clipView>
                    <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="contentScroller">
                        <rect key="frame" x="368" y="1" width="15" height="112"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" heightSizable="YES"/>
                    </scroller>
                </scrollView>
                <textField focusRingType="none" verticalHuggingPriority="750" id="summaryLabel">
                    <rect key="frame" x="8" y="4" width="384" height="16"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" selectable="YES" title="" id="summaryLabelCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" id="empty">
                    <rect key="frame" x="8" y="150" width="384" height="17"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="truncatingTail" selectable="YES" alignment="center" title="No data source selected" id="emptyCell">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <point key="canvasLocation" x="140" y="154"/>
        </customView>
    </objects>
</document>
