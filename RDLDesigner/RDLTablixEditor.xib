                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="addColumn:" target="-2" id="addColumnButtonAction"/>
                        </connections>
                    </button>
                    <button id="removeColumnButton">
                        <rect key="frame" x="100" y="86" width="80" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
