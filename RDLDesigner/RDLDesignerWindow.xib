                                    <rect key="frame" x="1" y="720" width="761" height="15"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                </scroller>
                                <scroller key="verticalScroller" verticalHuggingPriority="750" doubleValue="0.95538057742782156" horizontal="NO" id="canvasScrollVScroller">
                                    <rect key="frame" x="762" y="1" width="15" height="719"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                </scroller>
                            </scrollView>
                            <splitView fixedFrame="YES" arrangesAllSubviews="NO" dividerStyle="thin" translatesAutoresizingMaskIntoConstraints="NO" id="rightSplit">
                                <rect key="frame" x="1000" y="0.0" width="280" height="736"/>
                                <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                                <subviews>
                                    <scrollView fixedFrame="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="inspectorScroll">
                                        <rect key="frame" x="0.0" y="0.0" width="280" height="595"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <clipView key="contentView" copiesOnScroll="NO" id="inspectorScrollClip">
                                            <rect key="frame" x="1" y="1" width="263" height="578"/>
                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                            <subviews>
                                                <customView id="inspector" customClass="RDLInspectorView">
                                                    <rect key="frame" x="0.0" y="0.0" width="263" height="594"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                                                </customView>
                                            </subviews>
                                        </clipView>
                                        <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="inspectorScrollHScroller">
                                            <rect key="frame" x="1" y="579" width="263" height="15"/>
                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                        </scroller>
                                        <scroller key="verticalScroller" verticalHuggingPriority="750" doubleValue="1" horizontal="NO" id="inspectorScrollVScroller">
                                            <rect key="frame" x="264" y="1" width="15" height="578"/>
                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                        </scroller>
                                    </scrollView>
                                    <scrollView fixedFrame="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="dataScroll">
                                        <rect key="frame" x="0.0" y="596" width="280" height="140"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                                        <clipView key="contentView" copiesOnScroll="NO" id="dataScrollClip">
                                            <rect key="frame" x="1" y="1" width="263" height="123"/>
                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                            <subviews>
                                                <customView id="dataView" customClass="RDLDataView">
                                                    <rect key="frame" x="0.0" y="0.0" width="263" height="138"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                                                </customView>
                                            </subviews>
                                        </clipView>
                                        <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="dataScrollHScroller">
                                            <rect key="frame" x="1" y="124" width="263" height="15"/>
                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                        </scroller>
                                        <scroller key="verticalScroller" verticalHuggingPriority="750" doubleValue="1" horizontal="NO" id="dataScrollVScroller">
                                            <rect key="frame" x="264" y="1" width="15" height="123"/>
