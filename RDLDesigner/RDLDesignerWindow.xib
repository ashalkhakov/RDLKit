<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="RDLDesignerWindow">
            <connections>
                <outlet property="canvas" destination="canvas" id="canvasOutlet"/>
                <outlet property="canvasScroll" destination="canvasScroll" id="canvasScrollOutlet"/>
                <outlet property="centerTabView" destination="centerTabView" id="centerTabViewOutlet"/>
                <outlet property="centerMode" destination="centerMode" id="centerModeOutlet"/>
                <outlet property="dataView" destination="dataView" id="dataViewOutlet"/>
                <outlet property="datasetInspectorHost" destination="datasetInspectorHost" id="datasetInspectorHostOutlet"/>
                <outlet property="datasetNavigatorHost" destination="datasetNavigatorHost" id="datasetNavigatorHostOutlet"/>
                <outlet property="inspector" destination="inspector" id="inspectorOutlet"/>
                <outlet property="inspectorScroll" destination="inspectorScroll" id="inspectorScrollOutlet"/>
                <outlet property="leftTabView" destination="leftTabView" id="leftTabViewOutlet"/>
                <outlet property="leftTabBar" destination="leftTabBar" id="leftTabBarOutlet"/>
                <outlet property="outline" destination="outline" id="outlineOutlet"/>
                <outlet property="reportInspectorHost" destination="reportInspectorHost" id="reportInspectorHostOutlet"/>
                <outlet property="rightTabView" destination="rightTabView" id="rightTabViewOutlet"/>
                <outlet property="sourceHost" destination="sourceHost" id="sourceHostOutlet"/>
                <outlet property="split" destination="split" id="splitOutlet"/>
                <outlet property="window" destination="designerWindow" id="designerWindowOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="RDL Designer" allowsToolTipsWhenApplicationIsInactive="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="designerWindow">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <rect key="contentRect" x="60" y="40" width="1280" height="780"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1920" height="1055"/>
            <view key="contentView" id="designerContent">
                <rect key="frame" x="0.0" y="0.0" width="1280" height="780"/>
                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                <subviews>
                    <button id="previewButton">
                        <rect key="frame" x="1100" y="744" width="80" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Preview" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="previewButtonCell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="showPreview:" target="-2" id="previewButtonAction"/>
                        </connections>
                    </button>
                    <button id="pdfButton">
                        <rect key="frame" x="1190" y="744" width="80" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="PDF" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="pdfButtonCell">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="exportPDF:" target="-2" id="pdfButtonAction"/>
                        </connections>
                    </button>
                    <splitView fixedFrame="YES" arrangesAllSubviews="NO" dividerStyle="thin" vertical="YES" translatesAutoresizingMaskIntoConstraints="NO" id="split">
                        <rect key="frame" x="0.0" y="0.0" width="1280" height="736"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <customView fixedFrame="YES" id="leftPane">
                                <rect key="frame" x="0.0" y="0.0" width="220" height="736"/>
                                <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                                <subviews>
                                    <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="leftTabBar" customClass="DMTabBar">
                                        <rect key="frame" x="0" y="708" width="220" height="24"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                                    </customView>
                                    <tabView fixedFrame="YES" type="noTabsNoBorder" translatesAutoresizingMaskIntoConstraints="NO" id="leftTabView">
                                        <rect key="frame" x="0.0" y="0.0" width="220" height="708"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <tabViewItems>
                                            <tabViewItem label="Outline" identifier="outline" id="leftOutlineItem">
                                                <view key="view" id="leftOutlineItemView">
                                                    <rect key="frame" x="0.0" y="0.0" width="220" height="708"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <scrollView horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" id="outlineScroll">
                                                            <rect key="frame" x="0.0" y="28" width="220" height="680"/>
                                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                            <clipView key="contentView" copiesOnScroll="NO" id="outlineScrollClip">
                                                                <rect key="frame" x="1" y="1" width="203" height="663"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <subviews>
                                                                    <outlineView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" multipleSelection="NO" autosaveColumns="NO" indentationPerLevel="12" outlineTableColumn="outlineNameColumn" id="outline">
                                                                        <rect key="frame" x="0.0" y="0.0" width="208" height="663"/>
                                                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                        <size key="intercellSpacing" width="3" height="2"/>
                                                                        <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                                        <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                                                        <tableColumns>
                                                                            <tableColumn identifier="name" width="196" minWidth="40" maxWidth="1000" id="outlineNameColumn">
                                                                                <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" alignment="left" title="Report">
                                                                                    <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                                                    <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                                                                </tableHeaderCell>
                                                                                <textFieldCell key="dataCell" lineBreakMode="truncatingTail" selectable="YES" alignment="left" title="Text Cell" id="outlineNameCell">
                                                                                    <font key="font" metaFont="system"/>
                                                                                    <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                                                                </textFieldCell>
                                                                            </tableColumn>
                                                                        </tableColumns>
                                                                    </outlineView>
                                                                </subviews>
                                                            </clipView>
                                                            <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="outlineScrollHScroller">
                                                                <rect key="frame" x="1" y="664" width="203" height="15"/>
                                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            </scroller>
                                                            <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="outlineScrollVScroller">
                                                                <rect key="frame" x="204" y="1" width="15" height="663"/>
                                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            </scroller>
                                                        </scrollView>
                                                        <button toolTip="Add element…" id="addElementButton">
                                                            <rect key="frame" x="0.0" y="2" width="32" height="24"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                                            <buttonCell key="cell" type="square" title="+" bezelStyle="shadowlessSquare" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="addElementButtonCell">
                                                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                                                <font key="font" metaFont="system"/>
                                                            </buttonCell>
                                                            <connections>
                                                                <action selector="addElement:" target="-2" id="addElementButtonAction"/>
                                                            </connections>
                                                        </button>
                                                        <button toolTip="Remove selected element" id="removeElementButton">
                                                            <rect key="frame" x="32" y="2" width="32" height="24"/>
                                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                                            <buttonCell key="cell" type="square" title="–" bezelStyle="shadowlessSquare" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="removeElementButtonCell">
                                                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                                                <font key="font" metaFont="system"/>
                                                            </buttonCell>
                                                            <connections>
                                                                <action selector="removeElement:" target="-2" id="removeElementButtonAction"/>
                                                            </connections>
                                                        </button>
                                                    </subviews>
                                                </view>
                                            </tabViewItem>
                                            <tabViewItem label="Datasets" identifier="datasets" id="leftDatasetsItem">
                                                <view key="view" id="leftDatasetsItemView">
                                                    <rect key="frame" x="0.0" y="0.0" width="220" height="708"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="datasetNavigatorHost">
                                                            <rect key="frame" x="0.0" y="0.0" width="220" height="708"/>
                                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                            <subviews>
                                                                <textField focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="datasetNavigatorLabel">
                                                                    <rect key="frame" x="8" y="346" width="204" height="17"/>
                                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" flexibleMinY="YES"/>
                                                                    <textFieldCell key="cell" controlSize="small" lineBreakMode="wordWrapping" selectable="YES" alignment="center" title="Dataset navigator" id="datasetNavigatorLabelCell">
                                                                        <font key="font" metaFont="smallSystem"/>
                                                                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                                    </textFieldCell>
                                                                </textField>
                                                            </subviews>
                                                        </customView>
                                                    </subviews>
                                                </view>
                                            </tabViewItem>
                                        </tabViewItems>
                                    </tabView>
                                </subviews>
                            </customView>
                            <customView fixedFrame="YES" id="centerPane">
                                <rect key="frame" x="221" y="0.0" width="778" height="736"/>
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                <subviews>
                                    <segmentedControl verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="centerMode">
                                        <rect key="frame" x="8" y="712" width="160" height="20"/>
                                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                        <segmentedCell key="cell" controlSize="small" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="centerModeCell">
                                            <font key="font" metaFont="smallSystem"/>
                                            <segments>
                                                <segment label="Preview" width="80" selected="YES"/>
                                                <segment label="Source" width="80" tag="1"/>
                                            </segments>
                                        </segmentedCell>
                                        <connections><action selector="centerModeChanged:" target="-2" id="centerModeAction"/></connections>
                                    </segmentedControl>
                                    <tabView fixedFrame="YES" type="noTabsNoBorder" translatesAutoresizingMaskIntoConstraints="NO" id="centerTabView">
                                        <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <tabViewItems>
                                            <tabViewItem label="Preview" identifier="preview" id="centerPreviewItem">
                                                <view key="view" id="centerPreviewItemView">
                                                    <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <scrollView fixedFrame="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="canvasScroll">
                                                            <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                            <clipView key="contentView" copiesOnScroll="NO" id="canvasScrollClip">
                                                                <rect key="frame" x="1" y="1" width="761" height="691"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <subviews>
                                                                    <customView id="canvas" customClass="RDLCanvasView">
                                                                        <rect key="frame" x="0.0" y="-15" width="800" height="1100"/>
                                                                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                                    </customView>
                                                                </subviews>
                                                            </clipView>
                                                            <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="canvasScrollHScroller">
                                                                <rect key="frame" x="1" y="692" width="761" height="15"/>
                                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            </scroller>
                                                            <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="canvasScrollVScroller">
                                                                <rect key="frame" x="762" y="1" width="15" height="691"/>
                                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            </scroller>
                                                        </scrollView>
                                                    </subviews>
                                                </view>
                                            </tabViewItem>
                                            <tabViewItem label="Source" identifier="source" id="centerSourceItem">
                                                <view key="view" id="centerSourceItemView">
                                                    <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="sourceHost">
                                                            <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                            <subviews>
                                                                <textField focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="sourceLabel">
                                                                    <rect key="frame" x="8" y="346" width="762" height="17"/>
                                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" flexibleMinY="YES"/>
                                                                    <textFieldCell key="cell" controlSize="small" lineBreakMode="wordWrapping" selectable="YES" alignment="center" title="RDL source" id="sourceLabelCell">
                                                                        <font key="font" metaFont="smallSystem"/>
                                                                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                                                                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                                    </textFieldCell>
                                                                </textField>
                                                            </subviews>
                                                        </customView>
                                                    </subviews>
                                                </view>
                                            </tabViewItem>
                                            <tabViewItem label="Dataset" identifier="dataset" id="centerDatasetItem">
                                                <view key="view" id="centerDatasetItemView">
                                                    <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <scrollView fixedFrame="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="dataScroll">
                                                            <rect key="frame" x="0.0" y="0.0" width="778" height="708"/>
                                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                            <clipView key="contentView" copiesOnScroll="NO" id="dataScrollClip">
                                                                <rect key="frame" x="1" y="1" width="761" height="691"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <subviews>
                                                                    <customView id="dataView" customClass="RDLDataView">
                                                                        <rect key="frame" x="0.0" y="0.0" width="761" height="691"/>
                                                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                    </customView>
                                                                </subviews>
                                                            </clipView>
                                                            <scroller key="horizontalScroller" verticalHuggingPriority="750" horizontal="YES" id="dataScrollHScroller">
                                                                <rect key="frame" x="1" y="692" width="761" height="15"/>
                                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            </scroller>
                                                            <scroller key="verticalScroller" verticalHuggingPriority="750" horizontal="NO" id="dataScrollVScroller">
                                                                <rect key="frame" x="762" y="1" width="15" height="691"/>
                                                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                            </scroller>
                                                        </scrollView>
                                                    </subviews>
                                                </view>
                                            </tabViewItem>
                                        </tabViewItems>
                                    </tabView>
                                </subviews>
                            </customView>
                            <customView fixedFrame="YES" id="rightPane">
                                <rect key="frame" x="1000" y="0.0" width="280" height="736"/>
                                <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                                <subviews>
                                    <tabView fixedFrame="YES" type="noTabsNoBorder" translatesAutoresizingMaskIntoConstraints="NO" id="rightTabView">
                                        <rect key="frame" x="0.0" y="0.0" width="280" height="736"/>
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                        <font key="font" metaFont="system"/>
                                        <tabViewItems>
                                            <tabViewItem label="Element" identifier="element" id="rightElementItem">
                                                <view key="view" id="rightElementItemView">
                                                    <rect key="frame" x="0.0" y="0.0" width="280" height="708"/>
                                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                    <subviews>
                                                        <scrollView fixedFrame="YES" horizontalLineScroll="10" horizontalPageScroll="10" verticalLineScroll="10" verticalPageScroll="10" id="inspectorScroll">
                                                            <rect key="frame" x="0.0" y="0.0" width="280" height="708"/>
                                                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                            <clipView key="contentView" copiesOnScroll="NO" id="inspectorScrollClip">
                                                                <rect key="frame" x="1" y="1" width="263" height="691"/>
                                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                                <subviews>
                                                                    <customView id="inspector" customClass="RDLInspectorView">
                                                                        <rect key="frame" x="0.0" y="0.0" width="263" height="691"/>
                                                                        <autoresizingMask key="autoresizingMask" widthSizable="YES"/>
                                                                    </customView>
                                                                </subviews>
                                                            </clipView>
