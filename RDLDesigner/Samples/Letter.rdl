<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Letter</rd:ReportName>
    <Description>Blank letter with running header and folio.</Description>
    <Author>RDLDesigner</Author>
    <DataSets></DataSets>
    <ReportParameters>
        <ReportParameter Name="Title">
            <DataType>String</DataType>
            <Prompt>Title</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Untitled letter</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
    </ReportParameters>
    <ReportSections>
        <ReportSection>
            <Body>
                <Height>4.00000in</Height>
                <ReportItems>
                    <Textbox Name="Salutation">
                        <Top>0.20000in</Top>
                        <Left>0.00000in</Left>
                        <Width>7.50000in</Width>
                        <Height>0.30000in</Height>
                        <CanGrow>true</CanGrow>
                        <Style>
                            <FontFamily>Georgia</FontFamily>
                            <FontSize>12pt</FontSize>
                            <Color>#1a1916</Color>
                            <VerticalAlign>Top</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                        </Style>
                        <Paragraphs>
                            <Paragraph>
                                <TextRuns>
                                    <TextRun>
                                        <Value>Dear reader,</Value>
                                        <Style>
                                            <FontFamily>Georgia</FontFamily>
                                            <FontSize>12pt</FontSize>
                                            <Color>#1a1916</Color>
                                            <VerticalAlign>Top</VerticalAlign>
                                            <PaddingLeft>4pt</PaddingLeft>
                                            <PaddingRight>4pt</PaddingRight>
                                        </Style>
                                    </TextRun>
                                </TextRuns>
                            </Paragraph>
                        </Paragraphs>
                    </Textbox>
                    <Textbox Name="BodyCopy">
                        <Top>0.60000in</Top>
                        <Left>0.00000in</Left>
                        <Width>7.50000in</Width>
                        <Height>0.80000in</Height>
                        <CanGrow>true</CanGrow>
                        <Style>
                            <FontFamily>Georgia</FontFamily>
                            <FontSize>11pt</FontSize>
                            <Color>#1a1916</Color>
                            <VerticalAlign>Top</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft>
                            <PaddingRight>4pt</PaddingRight>
                        </Style>
                        <Paragraphs>
                            <Paragraph>
                                <TextRuns>
                                    <TextRun>
                                        <Value>Set the type. Bind a field. The page is a measure of 51 picas — enough room for a proper letter, an invoice, or a ledger.</Value>
                                        <Style>
                                            <FontFamily>Georgia</FontFamily>
                                            <FontSize>11pt</FontSize>
                                            <Color>#1a1916</Color>
                                            <VerticalAlign>Top</VerticalAlign>
                                            <PaddingLeft>4pt</PaddingLeft>
                                            <PaddingRight>4pt</PaddingRight>
                                        </Style>
                                    </TextRun>
                                </TextRuns>
                            </Paragraph>
                        </Paragraphs>
                    </Textbox>
                </ReportItems>
            </Body>
            <Width>7.50000in</Width>
            <Page>
                <PageHeight>11.00000in</PageHeight>
                <PageWidth>8.50000in</PageWidth>
                <LeftMargin>0.50000in</LeftMargin>
                <RightMargin>0.50000in</RightMargin>
                <TopMargin>0.50000in</TopMargin>
                <BottomMargin>0.50000in</BottomMargin>
                <PageHeader>
                    <Height>0.55000in</Height>
                    <ReportItems>
                        <Textbox Name="Brand">
                            <Top>0.08000in</Top>
                            <Left>0.00000in</Left>
                            <Width>2.20000in</Width>
                            <Height>0.28000in</Height>
                            <CanGrow>true</CanGrow>
                            <Style>
                                <FontFamily>Georgia</FontFamily>
                                <FontSize>11pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1a1916</Color>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingRight>4pt</PaddingRight>
                            </Style>
                            <Paragraphs>
                                <Paragraph>
                                    <TextRuns>
                                        <TextRun>
                                            <Value>RDL</Value>
                                            <Style>
                                                <FontFamily>Georgia</FontFamily>
                                                <FontSize>11pt</FontSize>
                                                <FontWeight>Bold</FontWeight>
                                                <Color>#1a1916</Color>
                                                <VerticalAlign>Top</VerticalAlign>
                                                <PaddingLeft>4pt</PaddingLeft>
                                                <PaddingRight>4pt</PaddingRight>
                                            </Style>
                                        </TextRun>
                                    </TextRuns>
                                </Paragraph>
                            </Paragraphs>
                        </Textbox>
                        <Textbox Name="DocTitle">
                            <Top>0.10000in</Top>
                            <Left>2.20000in</Left>
                            <Width>5.30000in</Width>
                            <Height>0.24000in</Height>
                            <CanGrow>true</CanGrow>
                            <Style>
                                <FontFamily>Helvetica</FontFamily>
                                <FontSize>9pt</FontSize>
                                <Color>#5c574e</Color>
                                <TextAlign>Right</TextAlign>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingRight>4pt</PaddingRight>
                            </Style>
                            <Paragraphs>
                                <Paragraph>
                                    <TextRuns>
                                        <TextRun>
                                            <Value>=Parameters!Title.Value</Value>
                                            <Style>
                                                <FontFamily>Helvetica</FontFamily>
                                                <FontSize>9pt</FontSize>
                                                <Color>#5c574e</Color>
                                                <TextAlign>Right</TextAlign>
                                                <VerticalAlign>Top</VerticalAlign>
                                                <PaddingLeft>4pt</PaddingLeft>
                                                <PaddingRight>4pt</PaddingRight>
                                            </Style>
                                        </TextRun>
                                    </TextRuns>
                                </Paragraph>
                            </Paragraphs>
                        </Textbox>
                        <Line Name="HRule">
                            <Top>0.42000in</Top>
                            <Left>0.00000in</Left>
                            <Width>7.50000in</Width>
                            <Height>0.02000in</Height>
                            <Style>
                                <FontFamily>Georgia</FontFamily>
                                <Color>#1a1916</Color>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingRight>4pt</PaddingRight>
                            </Style>
                        </Line>
                    </ReportItems>
                    <PrintOnFirstPage>true</PrintOnFirstPage>
                    <PrintOnLastPage>true</PrintOnLastPage>
                </PageHeader>
                <PageFooter>
                    <Height>0.40000in</Height>
                    <ReportItems>
                        <Line Name="FRule">
                            <Top>0.02000in</Top>
                            <Left>0.00000in</Left>
                            <Width>7.50000in</Width>
                            <Height>0.02000in</Height>
                            <Style>
                                <FontFamily>Georgia</FontFamily>
                                <Color>#1a1916</Color>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingRight>4pt</PaddingRight>
                            </Style>
                        </Line>
                        <Textbox Name="Folio">
                            <Top>0.10000in</Top>
                            <Left>0.00000in</Left>
                            <Width>7.50000in</Width>
                            <Height>0.22000in</Height>
                            <CanGrow>true</CanGrow>
                            <Style>
                                <FontFamily>Helvetica</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#5c574e</Color>
                                <TextAlign>Center</TextAlign>
                                <VerticalAlign>Top</VerticalAlign>
                                <PaddingLeft>4pt</PaddingLeft>
                                <PaddingRight>4pt</PaddingRight>
                            </Style>
                            <Paragraphs>
                                <Paragraph>
                                    <TextRuns>
                                        <TextRun>
                                            <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                                            <Style>
                                                <FontFamily>Helvetica</FontFamily>
                                                <FontSize>8pt</FontSize>
                                                <Color>#5c574e</Color>
                                                <TextAlign>Center</TextAlign>
                                                <VerticalAlign>Top</VerticalAlign>
                                                <PaddingLeft>4pt</PaddingLeft>
                                                <PaddingRight>4pt</PaddingRight>
                                            </Style>
                                        </TextRun>
                                    </TextRuns>
                                </Paragraph>
                            </Paragraphs>
                        </Textbox>
                    </ReportItems>
                    <PrintOnFirstPage>true</PrintOnFirstPage>
                    <PrintOnLastPage>true</PrintOnLastPage>
                </PageFooter>
            </Page>
        </ReportSection>
    </ReportSections>
</Report>