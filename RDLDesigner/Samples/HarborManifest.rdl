<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Harbor Manifest</rd:ReportName>
    <Description>Shipments from a JSON document and ports from an XML one.</Description>
    <Author>RDLDesigner</Author>
    <DataSources>
        <DataSource Name="Manifest">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Shipment":[{"No":"S-101","Port":"AST","Sailed":"2026-06-03","Season":"Summer 2026","Master":"A. Merrick","Crates":[{"Item":"Stoneware bowls","Qty":12,"Kg":38,"Season":"Summer 2026","Shipment":"S-101"},{"Item":"Glaze, cobalt","Qty":4,"Kg":22,"Season":"Summer 2026","Shipment":"S-101"}]},{"No":"S-102","Port":"PDX","Sailed":"2026-06-05","Season":"Summer 2026","Master":"L. Vale","Crates":[{"Item":"Kiln shelves","Qty":18,"Kg":96,"Season":"Summer 2026","Shipment":"S-102"},{"Item":"Firebrick","Qty":40,"Kg":210,"Season":"Summer 2026","Shipment":"S-102"},{"Item":"Pyrometric cones","Qty":6,"Kg":3,"Season":"Summer 2026","Shipment":"S-102"}]},{"No":"S-103","Port":"AST","Sailed":"2026-10-11","Season":"Autumn 2026","Master":"S. Reed","Crates":[{"Item":"Porcelain clay","Qty":25,"Kg":500,"Season":"Autumn 2026","Shipment":"S-103"},{"Item":"Brushes","Qty":9,"Kg":2,"Season":"Autumn 2026","Shipment":"S-103"}]},{"No":"S-104","Port":"HFX","Sailed":"2026-04-02","Season":"Spring 2026","Master":"N. Harbor","Crates":[{"Item":"Kiln bricks","Qty":30,"Kg":420,"Season":"Spring 2026","Shipment":"S-104"},{"Item":"Tongs","Qty":3,"Kg":11,"Season":"Spring 2026","Shipment":"S-104"}]}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
        <DataSource Name="Register">
            <ConnectionProperties>
                <DataProvider>XML</DataProvider>
                <ConnectString>xmldata=&lt;Ports&gt;&lt;Port Code="AST"&gt;&lt;Name&gt;Astoria&lt;/Name&gt;&lt;Country&gt;United States&lt;/Country&gt;&lt;/Port&gt;&lt;Port Code="PDX"&gt;&lt;Name&gt;Portland&lt;/Name&gt;&lt;Country&gt;United States&lt;/Country&gt;&lt;/Port&gt;&lt;Port Code="HFX"&gt;&lt;Name&gt;Halifax&lt;/Name&gt;&lt;Country&gt;Canada&lt;/Country&gt;&lt;/Port&gt;&lt;/Ports&gt;</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Shipments">
            <Query>
                <DataSourceName>Manifest</DataSourceName>
                <CommandText>$.Shipment[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="No">
                    <DataField>No</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Port">
                    <DataField>Port</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Sailed">
                    <DataField>Sailed</DataField>
                    <rd:TypeName>DateTime</rd:TypeName>
                </Field>
                <Field Name="Season">
                    <DataField>Season</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Master">
                    <DataField>Master</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
            </Fields>
            <Filters>
                <Filter>
                    <FilterExpression>=Fields!Season.Value</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                        <FilterValue>=Parameters!Season.Value</FilterValue>
                    </FilterValues>
                </Filter>
            </Filters>
        </DataSet>
        <DataSet Name="Crates">
            <Query>
                <DataSourceName>Manifest</DataSourceName>
                <CommandText>$.Shipment[*].Crates[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Shipment">
                    <DataField>Shipment</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Item">
                    <DataField>Item</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Qty">
                    <DataField>Qty</DataField>
                    <rd:TypeName>Integer</rd:TypeName>
                </Field>
                <Field Name="Kg">
                    <DataField>Kg</DataField>
                    <rd:TypeName>Integer</rd:TypeName>
                </Field>
                <Field Name="Season">
                    <DataField>Season</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
            </Fields>
            <Filters>
                <Filter>
                    <FilterExpression>=Fields!Season.Value</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                        <FilterValue>=Parameters!Season.Value</FilterValue>
                    </FilterValues>
                </Filter>
            </Filters>
        </DataSet>
        <DataSet Name="Heavy">
            <Query>
                <DataSourceName>Manifest</DataSourceName>
                <CommandText>$.Shipment[*].Crates[?(@.Qty &gt;= 10)]</CommandText>
            </Query>
            <Fields>
                <Field Name="Shipment">
                    <DataField>Shipment</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Item">
                    <DataField>Item</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Qty">
                    <DataField>Qty</DataField>
                    <rd:TypeName>Integer</rd:TypeName>
                </Field>
                <Field Name="Kg">
                    <DataField>Kg</DataField>
                    <rd:TypeName>Integer</rd:TypeName>
                </Field>
                <Field Name="Season">
                    <DataField>Season</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
            </Fields>
            <Filters>
                <Filter>
                    <FilterExpression>=Fields!Season.Value</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                        <FilterValue>=Parameters!Season.Value</FilterValue>
                    </FilterValues>
                </Filter>
            </Filters>
        </DataSet>
        <DataSet Name="Ports">
            <Query>
                <DataSourceName>Register</DataSourceName>
                <CommandText>//Port</CommandText>
            </Query>
            <Fields>
                <Field Name="Code">
                    <DataField>Code</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Name">
                    <DataField>Name</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
                <Field Name="Country">
                    <DataField>Country</DataField>
                    <rd:TypeName>String</rd:TypeName>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="Season">
            <DataType>String</DataType>
            <Prompt>Which season?</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Summer 2026</Value>
                </Values>
            </DefaultValue>
            <ValidValues>
                <ParameterValues>
                    <ParameterValue>
                        <Value>Spring 2026</Value>
                    </ParameterValue>
                    <ParameterValue>
                        <Value>Summer 2026</Value>
                    </ParameterValue>
                    <ParameterValue>
                        <Value>Autumn 2026</Value>
                    </ParameterValue>
                </ParameterValues>
            </ValidValues>
        </ReportParameter>
    </ReportParameters>
