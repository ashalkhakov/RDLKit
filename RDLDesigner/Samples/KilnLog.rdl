<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <Name>Kiln Log</Name>
    <Description>Firings with calculated yield, a dataset filter, and a table filtered to the losses.</Description>
    <Author>RDLDesigner</Author>
    <Width>7.50000in</Width>
    <DataSources>
        <DataSource Name="Demo">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Firings":[{"Batch":"B-101","Cracked":2,"FiredOn":"2026-06-03","Kiln":"North","Pieces":24},{"Batch":"B-102","Cracked":0,"FiredOn":"2026-06-05","Kiln":"North","Pieces":30},{"Batch":"B-103","Cracked":5,"FiredOn":"2026-06-09","Kiln":"South","Pieces":18},{"Batch":"B-104","Cracked":1,"FiredOn":"2026-06-12","Kiln":"South","Pieces":26},{"Batch":"B-105","Cracked":4,"FiredOn":"2026-06-16","Kiln":"North","Pieces":33},{"Batch":"B-000","Cracked":0,"FiredOn":"2026-06-01","Kiln":"North","Pieces":0}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Firings">
            <Query>
                <DataSourceName>Demo</DataSourceName>
                <CommandText>$.Firings[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Batch">
                    <DataField>Batch</DataField>
                </Field>
                <Field Name="Kiln">
                    <DataField>Kiln</DataField>
                </Field>
                <Field Name="FiredOn">
                    <DataField>FiredOn</DataField>
                </Field>
                <Field Name="Pieces">
                    <DataField>Pieces</DataField>
                </Field>
                <Field Name="Cracked">
                    <DataField>Cracked</DataField>
                </Field>
                <Field Name="Sound">
                    <Value>=Fields!Pieces.Value - Fields!Cracked.Value</Value>
                    <TypeName>Integer</TypeName>
                </Field>
                <Field Name="Yield">
                    <Value>=Round(100 * (Fields!Pieces.Value - Fields!Cracked.Value) / Fields!Pieces.Value, 1)</Value>
                    <TypeName>Float</TypeName>
                </Field>
            </Fields>
            <Filters>
                <Filter>
                    <FilterExpression>=Fields!Pieces.Value</FilterExpression>
                    <Operator>GreaterThan</Operator>
                    <FilterValues>
                        <FilterValue>0</FilterValue>
                    </FilterValues>
                </Filter>
            </Filters>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="Season">
            <DataType>String</DataType>
            <Prompt>Season</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Summer 2026</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
    </ReportParameters>
    <Body>
        <Height>4.40000in</Height>
