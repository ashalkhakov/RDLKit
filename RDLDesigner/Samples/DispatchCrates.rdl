<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <Name>Dispatch Crates</Name>
    <Description>The crates in one shipment. Shown inside Harbor Dispatch as a subreport, one instance per shipment, and readable on its own by giving it a shipment number.</Description>
    <Author>RDLDesigner</Author>
    <Width>3.70000in</Width>
    <DataSources>
        <DataSource Name="Manifest">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondoc=harbor-dispatch.json</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Crates">
            <Query>
                <DataSourceName>Manifest</DataSourceName>
                <CommandText>$.Shipment[*].Crates[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Shipment"><DataField>Shipment</DataField><TypeName>String</TypeName></Field>
                <Field Name="Item"><DataField>Item</DataField><TypeName>String</TypeName></Field>
                <Field Name="Qty"><DataField>Qty</DataField><TypeName>Integer</TypeName></Field>
                <Field Name="Weight"><DataField>Weight</DataField><TypeName>Float</TypeName></Field>
            </Fields>
            <Filters>
                <Filter>
                    <FilterExpression>=Fields!Shipment.Value</FilterExpression>
                    <Operator>Equal</Operator>
                    <FilterValues>
                        <FilterValue>=Parameters!Shipment.Value</FilterValue>
                    </FilterValues>
                </Filter>
            </Filters>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="Shipment">
            <DataType>String</DataType>
            <Prompt>Which shipment?</Prompt>
            <DefaultValue><Values><Value>S-2026-11</Value></Values></DefaultValue>
        </ReportParameter>
    </ReportParameters>
    <Body>
        <Height>1.10000in</Height>
        <ReportItems>
            <Tablix Name="CrateList">
                <Top>0in</Top><Left>0in</Left><Width>3.70000in</Width><Height>0.64000in</Height>
                <DataSetName>Crates</DataSetName>
                <NoRowsMessage>No crates in this shipment.</NoRowsMessage>
                <TablixBody>
                    <TablixColumns>
                        <TablixColumn><Width>2.30000in</Width></TablixColumn>
                        <TablixColumn><Width>0.60000in</Width></TablixColumn>
                        <TablixColumn><Width>0.80000in</Width></TablixColumn>
                    </TablixColumns>
                    <TablixRows>
                        <TablixRow><Height>0.22000in</Height><TablixCells><TablixCell><CellContents><Textbox Name="CrateHeadItem"><Width>2.3in</Width><Height>0.22in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#6b6357</Color><TextAlign>Left</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Item</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#6b6357</Color><TextAlign>Left</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CrateHeadQty"><Width>0.6in</Width><Height>0.22in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#6b6357</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Qty</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#6b6357</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CrateHeadWeight"><Width>0.8in</Width><Height>0.22in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#6b6357</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Weight</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#6b6357</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                        <TablixRow><Height>0.20000in</Height><TablixCells><TablixCell><CellContents><Textbox Name="CrateItem"><Width>2.3in</Width><Height>0.2in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#1a1916</Color><TextAlign>Left</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Item.Value</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#1a1916</Color><TextAlign>Left</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CrateQty"><Width>0.6in</Width><Height>0.2in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Qty.Value</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CrateWeight"><Width>0.8in</Width><Height>0.2in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign><Format>#,##0.0</Format></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Weight.Value</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign><Format>#,##0.0</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                        <TablixRow><Height>0.22000in</Height><TablixCells><TablixCell><CellContents><Textbox Name="CrateTotalLabel"><Width>2.3in</Width><Height>0.22in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CrateTotalQty"><Width>0.6in</Width><Height>0.22in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Qty.Value)</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="CrateTotalWeight"><Width>0.8in</Width><Height>0.22in</Height><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign><Format>#,##0.0</Format></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!Weight.Value)</Value><Style><FontFamily>Helvetica</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a1916</Color><TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign><Format>#,##0.0</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
                    </TablixRows>
                </TablixBody>
                <TablixRowHierarchy>
                    <TablixMembers>
                        <TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
                        <TablixMember><Group Name="CrateDetails" /></TablixMember>
                        <TablixMember />
                    </TablixMembers>
                </TablixRowHierarchy>
            </Tablix>
        </ReportItems>
    </Body>
    <Page>
        <PageHeight>11in</PageHeight><PageWidth>8.5in</PageWidth>
        <LeftMargin>0in</LeftMargin><RightMargin>0in</RightMargin>
        <TopMargin>0in</TopMargin><BottomMargin>0in</BottomMargin>
    </Page>
</Report>
