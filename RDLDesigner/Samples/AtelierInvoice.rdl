<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Atelier Invoice</rd:ReportName>
    <Description>Workshop invoice for Merrick &amp; Vale cabinetmakers.</Description>
    <Author>RDLDesigner</Author>
    <DataSources>
        <DataSource Name="Demo">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Items":[{"Amount":1840,"Description":"Walnut writing desk, oil finish","Qty":1,"Sku":"WV-12","Unit":1840},{"Amount":840,"Description":"White oak side chair","Qty":2,"Sku":"CH-04","Unit":420},{"Amount":265,"Description":"Turned brass desk lamp","Qty":1,"Sku":"LT-09","Unit":265},{"Amount":48,"Description":"Linen shade, natural","Qty":1,"Sku":"SH-02","Unit":48}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Items">
            <Query>
                <DataSourceName>Demo</DataSourceName>
                <CommandText>$.Items[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Sku">
                    <DataField>Sku</DataField>
                </Field>
                <Field Name="Description">
                    <DataField>Description</DataField>
                </Field>
                <Field Name="Qty">
                    <DataField>Qty</DataField>
                </Field>
                <Field Name="Unit">
                    <DataField>Unit</DataField>
                </Field>
                <Field Name="Amount">
                    <DataField>Amount</DataField>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="InvoiceNo">
            <DataType>String</DataType>
            <Prompt>InvoiceNo</Prompt>
            <DefaultValue>
                <Values>
                    <Value>MV-1842</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
        <ReportParameter Name="InvoiceDate">
            <DataType>String</DataType>
            <Prompt>InvoiceDate</Prompt>
            <DefaultValue>
                <Values>
                    <Value>26 Aug 2026</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
        <ReportParameter Name="BillTo">
            <DataType>String</DataType>
            <Prompt>BillTo</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Northlight Editorial</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
        <ReportParameter Name="BillAddr">
            <DataType>String</DataType>
            <Prompt>BillAddr</Prompt>
            <DefaultValue>
                <Values>
                    <Value>14 Reed Street, Portland</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
    </ReportParameters>
