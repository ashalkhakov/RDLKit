<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Harbor Packing Slip</rd:ReportName>
    <Description>North Wharf packing slip with ship-to block and carton list.</Description>
    <Author>RDLDesigner</Author>
    <DataSources>
        <DataSource Name="Demo">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Carton":[{"Carton":"A","Finish":"Sage buckram","Item":"Octavo cloth case","Qty":12},{"Carton":"A","Finish":"Laid ivory","Item":"Endsheet packet","Qty":12},{"Carton":"B","Finish":"Navy","Item":"Spine ribbon","Qty":12},{"Carton":"B","Finish":"Blind stamp","Item":"Title foil","Qty":1}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Carton">
            <Query>
                <DataSourceName>Demo</DataSourceName>
                <CommandText>$.Carton[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Item">
                    <DataField>Item</DataField>
                </Field>
                <Field Name="Finish">
                    <DataField>Finish</DataField>
                </Field>
                <Field Name="Qty">
                    <DataField>Qty</DataField>
                </Field>
                <Field Name="Carton">
                    <DataField>Carton</DataField>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="OrderNo">
            <DataType>String</DataType>
            <Prompt>OrderNo</Prompt>
            <DefaultValue>
                <Values>
                    <Value>NW-2209</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
        <ReportParameter Name="ShipTo">
            <DataType>String</DataType>
            <Prompt>ShipTo</Prompt>
            <DefaultValue>
                <Values>
                    <Value>The Reed Bindery</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
        <ReportParameter Name="ShipAddr">
            <DataType>String</DataType>
            <Prompt>ShipAddr</Prompt>
            <DefaultValue>
                <Values>
                    <Value>6 Dock Road, Astoria</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
    </ReportParameters>
