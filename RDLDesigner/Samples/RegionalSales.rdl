            <DataType>String</DataType>
            <Prompt>Shop</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Merrick &amp; Vale</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
    </ReportParameters>
