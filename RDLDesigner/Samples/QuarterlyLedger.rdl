<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <Name>Quarterly Ledger</Name>
    <Description>Q3 sales by month with a column chart and totals.</Description>
    <Author>RDLDesigner</Author>
    <Width>7.50000in</Width>
    <DataSources>
        <DataSource Name="Demo">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Months":[{"Month":"July","Orders":42,"Total":18640},{"Month":"August","Orders":51,"Total":22410},{"Month":"September","Orders":47,"Total":20115}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Months">
            <Query>
                <DataSourceName>Demo</DataSourceName>
                <CommandText>$.Months[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Month">
                    <DataField>Month</DataField>
                </Field>
                <Field Name="Orders">
                    <DataField>Orders</DataField>
                </Field>
                <Field Name="Total">
                    <DataField>Total</DataField>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
        <ReportParameter Name="Quarter">
            <DataType>String</DataType>
            <Prompt>Quarter</Prompt>
            <DefaultValue>
                <Values>
                    <Value>Q3 2026</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
        <ReportParameter Name="House">
            <DataType>String</DataType>
            <Prompt>House</Prompt>
            <DefaultValue>
                <Values>
                    <Value>RDLDesigner Press</Value>
                </Values>
            </DefaultValue>
        </ReportParameter>
    </ReportParameters>
    <Body>
        <Height>4.60000in</Height>
        <PrintOnFirstPage>true</PrintOnFirstPage>
        <PrintOnLastPage>true</PrintOnLastPage>
        <ReportItems>
            <Chart Name="ByMonth">
                <Top>0.15000in</Top>
                <Left>0.00000in</Left>
                <Width>7.50000in</Width>
                <Height>2.40000in</Height>
                <Style>
                    <FontFamily>Georgia</FontFamily>
                    <FontSize>10pt</FontSize>
                    <FontWeight>Normal</FontWeight>
                    <Color>#1a1916</Color>
                    <TextAlign>Left</TextAlign>
                    <VerticalAlign>Top</VerticalAlign>
                    <PaddingLeft>4pt</PaddingLeft>
                    <PaddingRight>4pt</PaddingRight>
                    <PaddingTop>2pt</PaddingTop>
                    <PaddingBottom>2pt</PaddingBottom>
                </Style>
                <DataSetName>Months</DataSetName>
                <ChartCategoryHierarchy>
                    <ChartMembers>
                        <ChartMember>
                            <Group Name="ByMonth_Category">
                                <GroupExpressions>
                                    <GroupExpression>=Fields!Month.Value</GroupExpression>
                                </GroupExpressions>
                            </Group>
                            <Label>=Fields!Month.Value</Label>
                        </ChartMember>
                    </ChartMembers>
                </ChartCategoryHierarchy>
                <ChartData>
                    <ChartSeriesCollection>
                        <ChartSeries Name="ByMonth_Series">
                            <ChartDataPoints>
                                <ChartDataPoint>
                                    <ChartDataPointValues>
                                        <Y>=Sum(Fields!Total.Value)</Y>
                                    </ChartDataPointValues>
                                </ChartDataPoint>
                            </ChartDataPoints>
                            <Type>Column</Type>
                        </ChartSeries>
                    </ChartSeriesCollection>
                </ChartData>
                <ChartAreas>
                    <ChartArea>
                        <ChartCategoryAxes>
                            <ChartAxis>
                                <ChartMajorGridLines></ChartMajorGridLines>
                                <MajorTickMarks>Outside</MajorTickMarks>
                            </ChartAxis>
                        </ChartCategoryAxes>
                        <ChartValueAxes>
                            <ChartAxis>
                                <ChartMajorGridLines></ChartMajorGridLines>
                                <MajorTickMarks>Outside</MajorTickMarks>
                            </ChartAxis>
                        </ChartValueAxes>
                    </ChartArea>
                </ChartAreas>
                <ChartLegends>
                    <ChartLegend>
                        <Position>RightCenter</Position>
                    </ChartLegend>
                </ChartLegends>
                <ChartTitles>
                    <ChartTitle>
                        <Caption>Net receipts</Caption>
                    </ChartTitle>
                </ChartTitles>
            </Chart>
