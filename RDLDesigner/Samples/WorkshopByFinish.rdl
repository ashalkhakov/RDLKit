    <rd:ReportUnitType>Inch</rd:ReportUnitType>
    <rd:ReportName>Workshop by Finish</rd:ReportName>
    <Description>Jobs grouped by finish, with a group header, details, and subtotal footer.</Description>
    <Author>RDLDesigner</Author>
    <DataSources>
        <DataSource Name="Demo">
            <ConnectionProperties>
                <DataProvider>JSON</DataProvider>
                <ConnectString>jsondata={"Finishes":[{"Finish":"Oil","Rate":40},{"Finish":"Lacquer","Rate":55},{"Finish":"Wax","Rate":28}],"Jobs":[{"Amount":1840,"Finish":"Oil","Hours":12,"Job":"Walnut writing desk"},{"Amount":420,"Finish":"Oil","Hours":6,"Job":"White oak side chair"},{"Amount":265,"Finish":"Lacquer","Hours":4,"Job":"Turned brass lamp"},{"Amount":48,"Finish":"Lacquer","Hours":1,"Job":"Linen shade"},{"Amount":610,"Finish":"Wax","Hours":8,"Job":"Open shelf"},{"Amount":190,"Finish":"Wax","Hours":3,"Job":"Shop stool"},{"Amount":95,"Finish":"Oil","Hours":2,"Job":"Picture frame"}]}</ConnectString>
            </ConnectionProperties>
        </DataSource>
    </DataSources>
    <DataSets>
        <DataSet Name="Jobs">
            <Query>
                <DataSourceName>Demo</DataSourceName>
                <CommandText>$.Jobs[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Job">
                    <DataField>Job</DataField>
                </Field>
                <Field Name="Finish">
                    <DataField>Finish</DataField>
                </Field>
                <Field Name="Hours">
                    <DataField>Hours</DataField>
                </Field>
                <Field Name="Amount">
                    <DataField>Amount</DataField>
                </Field>
            </Fields>
        </DataSet>
        <DataSet Name="Finishes">
            <Query>
                <DataSourceName>Demo</DataSourceName>
                <CommandText>$.Finishes[*]</CommandText>
            </Query>
            <Fields>
                <Field Name="Finish">
                    <DataField>Finish</DataField>
                </Field>
                <Field Name="Rate">
                    <DataField>Rate</DataField>
                </Field>
            </Fields>
        </DataSet>
    </DataSets>
    <ReportParameters>
