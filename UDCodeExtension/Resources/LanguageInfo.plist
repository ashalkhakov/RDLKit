<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Report Definition Language reports: XML (the grammar the XML mode's),
	     opened in RDLKitUI's designer (RDLExtension's
	     -workbench:editorForDocument:). The XML mode lists .rdl and .rdlc as
	     well; an installed extension's mode is registered after it, and wins. -->
	<key>languageModes</key>
	<array>
		<dict>
			<key>identifier</key>
			<string>rdl</string>
			<key>displayName</key>
			<string>RDL Report</string>
			<key>fileExtensions</key>
			<array>
				<string>rdl</string>
				<string>rdlc</string>
			</array>
			<key>grammarOf</key>
			<string>xml</string>
		</dict>
	</array>
</dict>
</plist>
