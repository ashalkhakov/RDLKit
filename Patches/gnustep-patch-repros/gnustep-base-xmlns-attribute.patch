+           * released (a namespace supplied through -addAttribute: as e.g.
+           * xmlns:rd="...").  Keep the qualified name literal; libxml prints
+           * an unnamespaced attribute by its full name, so the serialisation
+           * is unchanged. */
+          xmlNodeSetName(theNode, xmlName);
+          xmlFree(localName);
+          xmlFree(prefix);
+        }
+      else if (prefix != NULL)
         {
           if ((theNode->type == XML_ATTRIBUTE_NODE)
 	    || (theNode->type == XML_ELEMENT_NODE))
